# ── Render ────────────────────────────────────────────────────────────────────

def make_table(section, filter_text=""):
    color = section["color"]
    table = Table(
        box=box.SIMPLE,
        show_header=False,
        padding=(0, 1),
        expand=True,
    )
    table.add_column("Atajo", style=f"bold {color}", no_wrap=True, min_width=20)
    table.add_column("Descripción", style=f"{C['text']}")

    ft = filter_text.lower()
    matched = 0
    for key, desc in section["items"]:
        if ft and ft not in key.lower() and ft not in desc.lower():
            continue
        table.add_row(key, desc)
        matched += 1

    if matched == 0 and ft:
        return None  # skip section if nothing matches

    return Panel(
        table,
        title=f"[bold {color}]{section['title']}[/]",
        border_style=f"{C['surface1']}",
        padding=(0, 1),
    )


def render(console, filter_text="", scroll=0):
    panels = []
    for s in SECTIONS:
        p = make_table(s, filter_text)
        if p:
            panels.append(p)

    if not panels:
        console.print(
            Panel("[bold red]Sin resultados[/]", border_style=C["surface1"]),
            justify="center",
        )
        return

    # Show panels scrolled
    visible = panels[scroll:]
    for p in visible:
        console.print(p)

    # Footer
    footer = Text()
    footer.append("  ↑↓ j/k ", style=f"bold {C['mauve']}")
    footer.append("navegar  ", style=C["subtext0"])
    footer.append("/ ", style=f"bold {C['blue']}")
    footer.append("buscar  ", style=C["subtext0"])
    footer.append("q Esc ", style=f"bold {C['red']}")
    footer.append("salir", style=C["subtext0"])
    console.print(Padding(footer, (0, 1)))


def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            ch2 = sys.stdin.read(1)
            if ch2 == '[':
                ch3 = sys.stdin.read(1)
                return '\x1b[' + ch3
            return '\x1b'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    console = Console(highlight=False, force_terminal=True)
    scroll = 0
    filter_text = ""
    search_mode = False

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))

    def draw():
        console.clear()
        # Header
        title = Text()
        title.append("  herdr cheatsheet", style=f"bold {C['mauve']}")
        if filter_text:
            title.append(f"  /  {filter_text}", style=f"bold {C['yellow']}")
        if search_mode:
            title.append("▌", style=f"bold {C['yellow']}")
        console.print(Panel(title, border_style=C["mauve"], padding=(0, 1)))
        render(console, filter_text, scroll)

    draw()

    while True:
        ch = getch()

        if search_mode:
            if ch in ('\x1b', '\r', '\n'):
                search_mode = False
                scroll = 0
                draw()
            elif ch in ('\x7f', '\x08'):
                filter_text = filter_text[:-1]
                draw()
            else:
                filter_text += ch
                scroll = 0
                draw()
            continue

        if ch == '/':
            search_mode = True
            draw()
        elif ch in ('q', '\x1b', 'Q'):
            console.clear()
            sys.exit(0)
        elif ch in ('j', '\x1b[B'):  # down
            scroll = min(scroll + 1, max(0, len(SECTIONS) - 1))
            draw()
        elif ch in ('k', '\x1b[A'):  # up
            scroll = max(scroll - 1, 0)
            draw()
        elif ch == 'g':
            scroll = 0
            draw()
        elif ch == 'G':
            scroll = max(0, len(SECTIONS) - 1)
            draw()


if __name__ == "__main__":
    main()
