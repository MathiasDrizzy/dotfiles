eval "$(mise activate zsh)"

# Rutas locales
export PATH="$HOME/.local/bin:$PATH"

# Editor por defecto (yazi, git, etc.) — no vim
export EDITOR="code -w"
export VISUAL="$EDITOR"

# Inicializar sistema de autocompletado
autoload -Uz compinit && compinit -u

# Herramientas de productividad (Zoxide, Fzf, Atuin)
eval "$(zoxide init zsh)"
# fzf: usar fd y excluir cachés (~311k dirs -> ~7k, 8.5s -> 0.16s)
_FD_EXC="--hidden --follow --exclude .cache --exclude Library --exclude .npm --exclude .git --exclude node_modules --exclude .Trash"
export FZF_DEFAULT_COMMAND="fd --type f --strip-cwd-prefix ${_FD_EXC}"
export FZF_CTRL_T_COMMAND="fd --type f --type d --strip-cwd-prefix ${_FD_EXC}"
export FZF_ALT_C_COMMAND="fd --type d --strip-cwd-prefix ${_FD_EXC}"
export FZF_DEFAULT_OPTS="
  --height 60% --layout=reverse --border
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --color=selected-bg:#45475a
  --multi"

eval "$(fzf --zsh)"
eval "$(atuin init zsh)"

# Plugins de autocompletado y resaltado visual (orden estricto)
source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# yazi: la funcion y() deja la shell en la carpeta donde saliste
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d "" cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Aliases útiles
alias lg='lazygit'
alias ld='lazydocker'
alias sftp='termscp'
alias hosts='sshs'
alias sb='herdr plugin action invoke open-sidebar >/dev/null'
alias sb-ext='herdr-ctl adapt external'   # sidebar angosto (22 cols) para monitor externo
alias sb-lap='herdr-ctl adapt laptop'      # sidebar normal (24 cols) para laptop
alias sb-auto='herdr-ctl adapt'            # detecta monitor y ajusta automáticamente
alias mirador='mirador'

# Enjambre e Intercomunicación de Agentes (Socket Unix ~/.config/herdr/herdr.sock)
alias swarm='herdr-ctl swarm'
alias agents='herdr-ctl swarm'
alias aprompt='herdr-ctl prompt'
alias aread='herdr-ctl read'
alias afocus='herdr-ctl focus'

# Claude Code: bypass DISPONIBLE en el ciclo de Shift+Tab, apagado al inicio
alias claude='claude --allow-dangerously-skip-permissions'

# Antigravity (agy): bypass de confirmaciones — equivalente al claude de arriba
alias agy='agy --dangerously-skip-permissions'

# Prompt Starship
eval "$(starship init zsh)"


# Homebrew: actualizacion masiva (formulae + casks) y limpieza
brewup() {
  echo "==> 1/4 Actualizando indice de Homebrew"
  brew update || return 1
  echo "==> 2/4 Actualizando formulae y casks"
  brew upgrade
  echo "==> 3/4 Limpiando versiones viejas (conserva cache de descargas)"
  brew cleanup
  echo "==> 4/4 Diagnostico"
  brew doctor
}
alias brewout='brew outdated --verbose'   # ver que hay pendiente sin tocar nada

# Terminal Popup (scratchpad de herdr): salir con Escape si el prompt está vacío, o con Ctrl+Q
if [[ -n "${HERDR_POPUP:-}" ]]; then
  export KEYTIMEOUT=15
  _popup_exit_on_esc() {
    if [[ -z "$BUFFER" ]]; then
      exit 0
    else
      zle kill-whole-line
    fi
  }
  zle -N _popup_exit_on_esc
  bindkey '\e' _popup_exit_on_esc
  bindkey '^Q' _popup_exit_on_esc
fi
# >>> claude (cerebro) >>>
# Claude Code: antes de abrir se actualiza (`claude update`, instalación nativa) y arranca en bypass
# (sin pedir permisos). Los hooks de cada repo siguen corriendo igual. Para abrir sin bypass: `command claude`.
# Los subcomandos (update, mcp, doctor, etc.) pasan directo, sin actualizar ni agregar el flag.
unalias claude 2>/dev/null
claude() {
  case "$1" in
    update|upgrade|mcp|config|doctor|plugin|plugins|install|setup-token|migrate-installer|-v|--version|-h|--help)
      command claude "$@"; return ;;
  esac
  # Headless (-p/--print) o con la salida redirigida: sin actualizar, para no ensuciar la salida (claude -p | jq).
  local a
  for a in "$@"; do case "$a" in -p|--print) command claude --dangerously-skip-permissions "$@"; return ;; esac; done
  if [ -t 1 ]; then
    local salida
    if salida="$(command claude update 2>&1)"; then
      print -r -u2 -- "${salida##*$'\n'}"
    else
      print -r -u2 -- "claude: no se pudo actualizar; abro con la versión instalada ($(command claude --version 2>/dev/null))"
    fi
  fi
  command claude --dangerously-skip-permissions "$@"
}
