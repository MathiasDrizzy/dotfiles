eval "$(mise activate zsh)"

# Rutas locales
export PATH="$HOME/.local/bin:$PATH"

# Editor por defecto (git, lazyfinder, etc.) — no vim
export EDITOR="code -w"
export VISUAL="$EDITOR"

# Inicializar sistema de autocompletado
autoload -Uz compinit && compinit -u

# Herramientas de productividad (Zoxide, Fzf, Atuin)
eval "$(zoxide init zsh)"
# fzf: usar fd y excluir cachés (~311k dirs -> ~7k, 8.5s -> 0.16s)
_FD_EXC="--hidden --follow --exclude .cache --exclude Library --exclude .npm --exclude .git --exclude node_modules --exclude .Trash"
export FZF_DEFAULT_COMMAND="fd --type f --strip-cwd-prefix ${_FD_EXC}"
export FZF_CTRL_T_COMMAND="fd --type f --type d --strip-cwd-prefix ${_FD_EXC}"
export FZF_ALT_C_COMMAND="fd --type d --strip-cwd-prefix ${_FD_EXC}"
export FZF_DEFAULT_OPTS="
  --height 60% --layout=reverse --border
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --color=selected-bg:#45475a
  --multi"

eval "$(fzf --zsh)"
eval "$(atuin init zsh)"

# Plugins de autocompletado y resaltado visual (orden estricto)
source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# lazyfinder: shell function that leaves the shell in the folder you exit from (skipped if not installed).
# The init output is cached and regenerated only when the lazyfinder binary is newer, so startup does not spawn it.
if (( $+commands[lazyfinder] )); then
	_lf_init="${XDG_CACHE_HOME:-$HOME/.cache}/lazyfinder-init.zsh"
	if [[ ! -s $_lf_init || $commands[lazyfinder] -nt $_lf_init ]]; then
		mkdir -p -- "${_lf_init:h}" && lazyfinder --shell-init zsh >|"$_lf_init"
	fi
	[[ -s $_lf_init ]] && source "$_lf_init"
	unset _lf_init
fi

# Aliases útiles
alias lg='lazygit'
alias ld='lazydocker'
alias sftp='termscp'
alias hosts='sshs'
alias sb='herdr plugin action invoke lazyfinder.toggle >/dev/null'   # lazyfinder sidebar

# Enjambre e Intercomunicación de Agentes (Socket Unix ~/.config/herdr/herdr.sock)
alias swarm='herdr-ctl swarm'
alias agents='herdr-ctl swarm'
alias aprompt='herdr-ctl prompt'
alias aread='herdr-ctl read'
alias afocus='herdr-ctl focus'

# Claude Code: bypass DISPONIBLE en el ciclo de Shift+Tab, apagado al inicio
alias claude='claude --allow-dangerously-skip-permissions'

# Antigravity (agy): bypass de confirmaciones — equivalente al claude de arriba
alias agy='agy --dangerously-skip-permissions'

# Prompt Starship
eval "$(starship init zsh)"


# Homebrew: actualizacion masiva (formulae + casks) y limpieza
brewup() {
  # Sin preguntas: HOMEBREW_NO_ASK salta el "[y/n]" de brew 7 y SUDO_ASKPASS apunta a un
  # programa que falla, asi que sudo nunca pide contrasena (un cask que la
  # necesite falla y queda listado en vez de bloquear).
  local -x NONINTERACTIVE=1 HOMEBREW_NO_ASK=1 HOMEBREW_NO_ENV_HINTS=1 SUDO_ASKPASS=/usr/bin/false
  echo "==> 1/4 Actualizando indice de Homebrew"
  brew update || return 1
  echo "==> 2/4 Actualizando formulae y casks"
  brew upgrade
  echo "==> 3/4 Limpiando versiones viejas (conserva cache de descargas)"
  brew cleanup
  echo "==> 4/4 Diagnostico"
  brew doctor
}
alias brewout='brew outdated --verbose'   # ver que hay pendiente sin tocar nada

# Terminal Popup (scratchpad de herdr): salir con Escape si el prompt está vacío, o con Ctrl+Q
if [[ -n "${HERDR_POPUP:-}" ]]; then
  export KEYTIMEOUT=15
  _popup_exit_on_esc() {
    if [[ -z "$BUFFER" ]]; then
      exit 0
    else
      zle kill-whole-line
    fi
  }
  zle -N _popup_exit_on_esc
  bindkey '\e' _popup_exit_on_esc
  bindkey '^Q' _popup_exit_on_esc
fi
