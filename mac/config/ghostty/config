# Tipografía
font-family = "JetBrainsMono Nerd Font"
font-size = 14
cursor-style = block
cursor-style-blink = false

# Tema
theme = "Catppuccin Mocha"

# Translucent glass effect, without blur (the blur renders gray in screenshots and Mission Control)
background-opacity = 0.85
background-blur = false
macos-titlebar-style = hidden
macos-window-shadow = true

# Atajos y espaciado
macos-option-as-alt = right
window-padding-x = 16
window-padding-y = 16

# Cmd+C: si Ghostty tiene una selección, la copia; si no (dentro de herdr la selección
# es de herdr), reenvía Cmd+C a la app para que herdr copie su propia selección.
keybind = performable:super+c=copy_to_clipboard
