# Auto Title (herdr plugin): names tabs after what runs in them. Read once at start:
# `herdr plugin action invoke herdr.auto-title.restart` after a change.

# No branch in tab titles: a tab reads `dotfiles`, or `dotfiles › micro` with a program open.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Tabs only, never panes: naming panes labeled a Claude pane in the lazyfinder repo "lazyfinder", which is how the
# lazyfinder plugin finds its sidebar (it closed that pane as if it were the sidebar), and renamed sidebars too.
HERDR_AUTO_TITLE_PANES=false
