{
    "colorscheme": "dotfiles-mocha",
    "truecolor": "on",
    "mouse": true,
    "softwrap": true,
    "diffgutter": true,
    "ruler": true,
    "tabsize": 4,
    "tabstospaces": true,
    "savecursor": true,
    "basename": true,
    "statusformatl": "$(filename) $(modified)",
    "statusformatr": "$(line):$(col)  $(opt:filetype)  ·  ctrl-g ayuda"
}
