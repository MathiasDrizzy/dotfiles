#!/usr/bin/env bash
# SketchyBar: left = Apple menu, active app menus, AeroSpace workspaces and now playing; right = a "<" that expands the
# status items, the date and the time. Docs: https://felixkratz.github.io/SketchyBar/  ·  reload: sketchybar --reload

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
# the same family as the Ghostty terminal
FONT="JetBrainsMono Nerd Font"

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"
# shellcheck source=icons.sh
source "$CONFIG_DIR/icons.sh"

# The bar itself is transparent: the glass lives in the pills (brackets) below, so there is a clear gap around the
# camera housing. notch_width keeps the left pills and the right pill apart on the built-in display.
sketchybar --bar \
  position=top height=32 margin=10 y_offset=4 corner_radius=12 \
  color=$TRANSPARENT border_width=0 \
  padding_left=8 padding_right=0 notch_width=210 \
  topmost=on sticky=on shadow=off

sketchybar --default \
  updates=on \
  icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" label.font="$FONT:Regular:$TEXT_SIZE" \
  icon.color="$TEXT" label.color="$TEXT" \
  icon.padding_left=8 icon.padding_right=4 label.padding_left=0 label.padding_right=8 \
  padding_left=1 padding_right=1 \
  background.height=24 background.corner_radius=8 background.drawing=off

pill() { # item or bracket name: the glass look shared by every pill
  sketchybar --set "$1" \
    background.color="$BAR_COLOR" background.border_color="$BAR_BORDER" background.border_width=1 \
    background.height=30 background.corner_radius=12 background.drawing=on
}

# --- Left: Apple menu (a popup with the system actions) ---
sketchybar --add item apple left \
  --set apple \
  icon="$APPLE" icon.color="$MAUVE" icon.font="$APPLE_FONT:Regular:$APPLE_SIZE" icon.width=34 icon.align=center icon.padding_left=0 icon.padding_right=0 label.drawing=off \
  popup.background.color=0xf21e1e2e popup.background.border_color="$BAR_BORDER" \
  popup.background.border_width=1 popup.background.corner_radius=12 popup.align=left \
  script="$PLUGIN_DIR/apple.sh" \
  --subscribe apple mouse.entered mouse.exited mouse.exited.global mouse.clicked
pill apple

apple_entry() { # name, icon, label, command
  sketchybar --add item "apple.$1" popup.apple \
    --set "apple.$1" icon="$2" label="$3" icon.color="$MAUVE" icon.width=30 icon.align=center icon.padding_left=6 icon.padding_right=2 label.padding_right=14 \
    script="$PLUGIN_DIR/hover.sh" click_script="$PLUGIN_DIR/apple.sh close; $4" \
    --subscribe "apple.$1" mouse.entered mouse.exited
}
apple_entry about "$ICON_INFO" "Acerca de este Mac" "$PLUGIN_DIR/about.sh"
apple_entry settings "$SETTINGS" "Ajustes del Sistema" "open -a 'System Settings'"
apple_entry sleep "$SLEEP" "Suspender" "pmset sleepnow"
apple_entry lock "$LOCK" "Bloquear pantalla" "pmset displaysleepnow"
apple_entry logout "$LOGOUT" "Cerrar sesión" "osascript -e 'tell application \"System Events\" to log out'"
apple_entry restart "$RESTART" "Reiniciar" "osascript -e 'tell application \"System Events\" to restart'"
sketchybar --set apple.restart icon.font="$NERD_FONT:Regular:$ICON_SIZE"
apple_entry shutdown "$POWER" "Apagar" "osascript -e 'tell application \"System Events\" to shut down'"

# --- Left: the active app; click for its menus (File, Edit, View...) in a popup ---
sketchybar --add item front_app left \
  --set front_app icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" icon.color="$MAUVE" icon.width=34 icon.align=center \
  icon.padding_left=0 icon.padding_right=0 label.drawing=off \
  popup.background.color=0xf21e1e2e popup.background.border_color="$BAR_COLOR" \
  popup.background.border_width=1 popup.background.corner_radius=12 popup.align=left \
  script="$PLUGIN_DIR/appmenu.sh" \
  --subscribe front_app front_app_switched mouse.entered mouse.exited mouse.exited.global mouse.clicked
sketchybar --add bracket front_pill front_app
pill front_pill
# shellcheck source=icon_map.sh disable=SC1091
source "$CONFIG_DIR/icon_map.sh"
__icon_map "$(aerospace list-windows --focused --format '%{app-name}' 2>/dev/null)"
# shellcheck disable=SC2154 # icon_result is set by __icon_map
sketchybar --set front_app icon="$icon_result"

# --- Left: AeroSpace workspaces ---
sketchybar --add event aerospace_workspace_change
# Items start hidden, so the remembered row must start empty too.
rm -f "$HOME/.cache/sketchybar/spaces"
first_space=true
for sid in $(aerospace list-workspaces --all); do
  # One item drives the whole row (it alone listens to the workspace event and ticks); the others only react to the mouse.
  if $first_space; then
    driver=(update_freq=1 script="$PLUGIN_DIR/aerospace.sh $sid refresh")
    sketchybar --add item "space.$sid" left --subscribe "space.$sid" aerospace_workspace_change
    first_space=false
  else
    driver=(script="$PLUGIN_DIR/aerospace.sh $sid")
    sketchybar --add item "space.$sid" left
  fi
  sketchybar --subscribe "space.$sid" mouse.entered mouse.exited \
    --set "space.$sid" \
    icon="$sid" icon.width=26 icon.align=center icon.padding_left=0 icon.padding_right=0 icon.font="$FONT:Bold:$TEXT_SIZE" \
    label.drawing=off drawing=off background.drawing=on background.color="$TRANSPARENT" \
    click_script="$PLUGIN_DIR/close_popups.sh; aerospace workspace $sid" \
    "${driver[@]}"
done
sketchybar --add bracket spaces '/space\..*/'
pill spaces

# --- Left: now playing (only visible while something plays) ---
# Now playing: previous / play-pause / next, then the title (marquee.sh bounces it smoothly). media.sh hides all of them when
# nothing is loaded.
media_button() { # name, icon, command, font size
  sketchybar --add item "$1" left \
    --set "$1" drawing=off icon="$2" icon.color="$MAUVE" icon.font="$APP_ICON_FONT:Regular:${4:-$ICON_SIZE}" icon.width=22 icon.align=center \
    icon.padding_left=0 icon.padding_right=0 label.drawing=off background.height=24 background.corner_radius=8 \
    script="$PLUGIN_DIR/hover.sh" click_script="$PLUGIN_DIR/close_popups.sh; $3" \
    --subscribe "$1" mouse.entered mouse.exited mouse.clicked
}
media_button media_prev "$PREV" "media-control previous-track" "$ARROW_SIZE"
media_button media_play "$PLAY" "$PLUGIN_DIR/media_toggle.sh"
media_button media_next "$NEXT" "media-control next-track" "$ARROW_SIZE"
sketchybar --add item media left \
  --set media drawing=off icon.drawing=off label.font="$FONT:Regular:$TEXT_SIZE" label.width=144 label.padding_left=0 label.padding_right=10 \
  update_freq=2 script="$PLUGIN_DIR/media.sh" \
  click_script="$PLUGIN_DIR/close_popups.sh; media-control toggle-play-pause"
sketchybar --add bracket media_pill media_prev media_play media_next media
pill media_pill

# --- Right (added right to left): chevron, date and time, then the expandable status items; each in its own pill ---
# macOS draws its microphone dot over the right end of the bar, so that spot gets its own pill: the icon lights up
# while the dot is on and the dot sits inside the pill instead of over the chevron.
sketchybar --add item privacy right \
  --set privacy icon="$MIC" icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" icon.color="$OVERLAY0" icon.width=34 icon.align=left \
  icon.padding_left=10 icon.padding_right=0 label.drawing=off update_freq=2 script="$PLUGIN_DIR/privacy.sh" \
  --add item chevron right \
  --set chevron icon="$CHEVRON_LEFT" icon.font="$APP_ICON_FONT:Regular:$ARROW_SIZE" icon.color="$MAUVE" \
  icon.width=34 icon.align=center icon.padding_left=0 icon.padding_right=0 label.drawing=off \
  script="$PLUGIN_DIR/hover.sh 0xf0313244 0xd91e1e2e" click_script="$PLUGIN_DIR/close_popups.sh; $PLUGIN_DIR/toggle.sh" \
  --subscribe chevron mouse.entered mouse.exited \
  --add item clock right \
  --set clock icon.drawing=off label.font="$FONT:Bold:$TEXT_SIZE" label.padding_left=12 label.padding_right=12 update_freq=10 \
  script="$PLUGIN_DIR/clock.sh" click_script="$PLUGIN_DIR/close_popups.sh; open -a Calendar" \
  --subscribe clock mouse.entered mouse.exited \
  --add item battery right \
  --set battery icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" icon.width=22 icon.align=center icon.padding_left=10 icon.padding_right=0 \
  label.padding_left=2 label.padding_right=12 update_freq=30 script="$PLUGIN_DIR/battery.sh" \
  click_script="open x-apple.systempreferences:com.apple.Battery-Settings.extension" \
  --subscribe battery system_woke power_source_change mouse.entered mouse.exited \
  --add item control right \
  --set control icon="$CONTROL" icon.color="$MAUVE" icon.width=34 icon.align=center icon.padding_left=0 icon.padding_right=0 \
  label.drawing=off label.padding_left=0 label.padding_right=10 update_freq=5 script="$PLUGIN_DIR/control.sh" \
  click_script="$PLUGIN_DIR/controlcenter.sh" \
  --subscribe control wifi_change mouse.entered mouse.exited \
  --add item sys_mem right \
  --set sys_mem icon="$RAM" icon.color="$MAUVE" icon.padding_left=8 icon.padding_right=4 label.padding_right=12 \
  --add item sys right \
  --set sys icon="$CPU" icon.color="$MAUVE" icon.padding_left=12 icon.padding_right=4 label.padding_right=8 update_freq=2 script="$PLUGIN_DIR/sys.sh" \
  --add bracket sys_pill sys sys_mem \
  --set sys_pill script="$PLUGIN_DIR/hover.sh 0xf0313244 0xd91e1e2e" click_script="$PLUGIN_DIR/monitor.sh" \
  --subscribe sys_pill mouse.entered mouse.exited

for name in privacy chevron clock battery control sys_pill; do pill "$name"; done

# Status items start collapsed; the chevron toggles them.
sketchybar --set sys drawing=off --set sys_mem drawing=off --set sys_pill drawing=off --set control drawing=off --set battery drawing=off

sketchybar --hotload on
sketchybar --update
