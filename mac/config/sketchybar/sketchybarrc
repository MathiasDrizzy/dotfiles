#!/usr/bin/env bash
# SketchyBar, built on neutonfoo/dotfiles's bar (https://github.com/neutonfoo/dotfiles, shared by its author): his layout,
# boxes, Catppuccin Macchiato colors, font and glyphs, plus ours: the AeroSpace workspaces with their clicks, drag and
# animations, the active app's menus, now playing, Vorssaint and Control Center.
# left = Apple menu, front app, workspaces; left of the notch = weather; right of it = now playing;
# right = Vorssaint, battery, date and time, Control Center at the edge.
# Docs: https://felixkratz.github.io/SketchyBar/  ·  reload: sketchybar --reload

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font"

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"
# shellcheck source=icons.sh
source "$CONFIG_DIR/icons.sh"

# The bar itself is transparent: every item sits in a solid box of its own below, so there is a clear gap around the
# camera housing. notch_width keeps the two sides apart on the built-in display, clear of the camera housing. The bar spans the whole top strip (the
# cover's size) and never changes: a resize redraws every box and the bar shook for half a second.
sketchybar --bar \
  position=top height=40 margin=0 y_offset=0 corner_radius=0 \
  color=$TRANSPARENT border_width=0 \
  padding_left=0 padding_right=0 notch_width="$NOTCH_WIDTH" display=main \
  topmost=on sticky=on shadow=off

# His defaults: Medium text, 5 points around the icon and after the label, 5 points between boxes.
# Icons default to the sketchybar-app-font pack: its glyphs are ligatures (":gear:") that any other font prints as text, so
# the Nerd Font glyphs set their font themselves. Hidden items skip their updates (the few that must run while hidden, like
# now playing, say updates=on).
sketchybar --default \
  updates=when_shown \
  icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" label.font="$FONT:Medium:$TEXT_SIZE" \
  icon.color="$TEXT" label.color="$TEXT" \
  icon.padding_left=5 icon.padding_right=5 label.padding_left=0 label.padding_right=5 \
  padding_left=2 padding_right=3 \
  background.height=24 background.corner_radius=8 background.drawing=off

# The cover (cover.sh): a picture of the wallpaper strip behind the bar, so the native menu bar the system slides down (pointer
# at the top, Control Center or a menu open) stays hidden and the bar still looks like the desktop. It is the first bracket,
# so every box paints over it, and it spans two empty edge items that hold the boxes off the screen's edges (an empty item
# ignores its padding). The right one leaves the macOS recording dot a free spot of its own.
sketchybar --add item cover_left left --add item cover_right right \
  --set cover_left width=21 padding_left=0 padding_right=0 icon.drawing=off label.drawing=off \
  --set cover_right width=34 padding_left=0 padding_right=0 icon.drawing=off label.drawing=off \
  --add bracket cover cover_left cover_right \
  --set cover drawing=off background.drawing=on background.color="$TRANSPARENT" background.height=40 background.corner_radius=0
# Takes the cover's picture again when the wallpaper changes (cover.sh refresh: one stat while nothing changed).
sketchybar --add item cover_watch left \
  --set cover_watch drawing=off updates=on update_freq=10 script="$PLUGIN_DIR/cover.sh refresh"

pill() { # item or bracket name: the box every item sits in
  sketchybar --set "$1" background.color="$BAR_COLOR" background.border_width=0 \
    background.height="$PILL_HEIGHT" background.corner_radius="$PILL_RADIUS" background.drawing=on
}

# --- Right edge: Control Center ---
# macOS opens its panel at the right edge of the screen (it cannot be moved before it shows), so the button stays right above
# it: the first item after the edge spacer, always drawn and one fixed width (its icon's: a fixed item width would swallow
# the padding that parts the boxes), with nothing to its right that changes. It is made before anything else, so a reload
# leaves it off the bar for as short a time as possible.
sketchybar --add item control right \
  --set control icon="$CONTROL" icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" icon.color="$MAUVE" icon.width=28 \
  icon.align=center icon.padding_left=0 icon.padding_right=0 label.drawing=off update_freq=5 \
  script="$PLUGIN_DIR/control.sh" click_script="$PLUGIN_DIR/controlcenter.sh" \
  --subscribe control wifi_change mouse.entered mouse.exited
pill control

# --- Left: Apple menu (a popup with the system actions) ---
sketchybar --add item apple left \
  --set apple \
  icon="$APPLE" icon.color="$APPLE_ICON" icon.font="$APPLE_FONT:Regular:$APPLE_SIZE" icon.width=28 icon.align=center icon.padding_left=0 icon.padding_right=0 label.drawing=off \
  popup.background.color="$BASE" popup.background.border_color="$BAR_BORDER" \
  popup.background.border_width=1 popup.background.corner_radius=12 popup.align=left \
  script="$PLUGIN_DIR/apple.sh" \
  --subscribe apple mouse.entered mouse.exited mouse.exited.global mouse.clicked
pill apple
sketchybar --set apple background.color="$APPLE_BG"

apple_entry() { # name, icon, label, command, icon color
  sketchybar --add item "apple.$1" popup.apple \
    --set "apple.$1" icon="$2" icon.font="$NERD_FONT:Regular:$ICON_SIZE" label="$3" icon.color="$5" icon.width=30 icon.align=center icon.padding_left=6 icon.padding_right=2 label.padding_right=14 \
    script="$PLUGIN_DIR/hover.sh" click_script="$PLUGIN_DIR/apple.sh close; $4" \
    --subscribe "apple.$1" mouse.entered mouse.exited
}
apple_entry about "$ICON_INFO" "Acerca de este Mac" "$PLUGIN_DIR/about.sh" "$BLUE"
apple_entry settings "$SETTINGS" "Ajustes del Sistema" "open -a 'System Settings'" "$TEAL"
apple_entry sleep "$SLEEP" "Suspender" "pmset sleepnow" "$MAUVE"
apple_entry lock "$LOCK" "Bloquear pantalla" "pmset displaysleepnow" "$YELLOW"
apple_entry logout "$LOGOUT" "Cerrar sesión" "osascript -e 'tell application \"System Events\" to log out'" "$PEACH"
apple_entry restart "$RESTART" "Reiniciar" "osascript -e 'tell application \"System Events\" to restart'" "$GREEN"
apple_entry shutdown "$POWER" "Apagar" "osascript -e 'tell application \"System Events\" to shut down'" "$RED"

# --- Left: the front app (his green block with the app's icon, an arrow and its name); click for its menus ---
sketchybar --add item front_app left \
  --set front_app icon.font="$APP_ICON_FONT:Regular:$ICON_SIZE" icon.color="$BASE" icon.width=28 icon.align=center \
  icon.padding_left=0 icon.padding_right=0 label.drawing=off padding_left=4 padding_right=0 \
  background.drawing=on background.color="$APP_BLOCK" background.height="$PILL_HEIGHT" background.corner_radius="$PILL_RADIUS" \
  script="$PLUGIN_DIR/appmenu.sh" \
  --subscribe front_app front_app_switched mouse.entered mouse.exited mouse.exited.global mouse.clicked \
  --add item front_app.arrow left \
  --set front_app.arrow icon="$POWERLINE_ARROW" icon.font="$NERD_FONT:Bold:$ARROW_BLOCK_SIZE" icon.color="$APP_BLOCK" \
  icon.padding_left=0 icon.padding_right=0 icon.y_offset=1 label.drawing=off padding_left=-3 padding_right=0 \
  --add item front_app.name left \
  --set front_app.name icon.drawing=off label.font="$FONT:Bold:$TEXT_SIZE" label.width="$APP_NAME_WIDTH" label.align=center \
  label.padding_left=4 label.padding_right=8 \
  padding_left=0 script="$PLUGIN_DIR/appmenu.sh" \
  --subscribe front_app.name mouse.entered mouse.exited mouse.clicked \
  --add item front_app.measure left \
  --set front_app.measure width=0 padding_left=0 padding_right=0 icon.drawing=off label.color="$TRANSPARENT" \
  label.font="$FONT:Bold:$TEXT_SIZE" label.padding_left=0 label.padding_right=0 \
  --add bracket front_pill front_app front_app.arrow front_app.name \
  --set front_pill popup.background.color="$BASE" popup.background.border_color="$BAR_BORDER" \
  popup.background.border_width=1 popup.background.corner_radius=12 popup.align=center # the menus, centered under the pill
pill front_pill
# shellcheck source=icon_map.sh disable=SC1091
source "$CONFIG_DIR/icon_map.sh"
__icon_map "$(aerospace list-windows --focused --format '%{app-name}' 2>/dev/null)"
# shellcheck disable=SC2154 # icon_result is set by __icon_map
sketchybar --set front_app icon="$icon_result" \
  --set front_app.name label="$(lsappinfo info -only name "$(lsappinfo front)" 2>/dev/null | sed -n '1s/^"\(.*\)" ASN:.*/\1/p')"

# Two brackets side by side touch (a bracket spans its members' padding too): an empty item keeps the usual gap.
sketchybar --add item front_gap left \
  --set front_gap width="$PILL_GAP" padding_left=0 padding_right=0 icon.drawing=off label.drawing=off

# --- Left: AeroSpace workspaces (his current-space block, for every workspace: the focused one is the mauve block) ---
sketchybar --add event aerospace_workspace_change
# Items start hidden, so the remembered row must start empty too.
rm -f "$HOME/.cache/sketchybar/spaces" "$HOME/.cache/sketchybar/media_dirty" "$HOME/.cache/sketchybar/fit_slots" \
  "$HOME/.cache/sketchybar/fit_name_w" "$HOME/.cache/sketchybar/fit_media_chars"
rmdir "$HOME/.cache/sketchybar/media_busy" "$HOME/.cache/sketchybar/cover_busy" \
  "$HOME/.cache/sketchybar/cover_settler" 2>/dev/null
first_space=true
for sid in $(aerospace list-workspaces --all); do
  # One item drives the whole row (it alone listens to the workspace event and ticks); the others only react to the mouse.
  if $first_space; then
    driver=(update_freq=1 updates=on script="$PLUGIN_DIR/aerospace.sh $sid refresh")
    sketchybar --add item "space.$sid" left --subscribe "space.$sid" aerospace_workspace_change
    first_space=false
  else
    driver=(script="$PLUGIN_DIR/aerospace.sh $sid")
    sketchybar --add item "space.$sid" left
  fi
  sketchybar --subscribe "space.$sid" mouse.entered mouse.exited \
    --set "space.$sid" \
    icon="${sid#e}" icon.width=26 icon.align=center icon.padding_left=0 icon.padding_right=0 icon.font="$FONT:Bold:$TEXT_SIZE" \
    label.drawing=off drawing=off padding_left=1 padding_right=1 \
    background.drawing=on background.color="$TRANSPARENT" background.height="$PILL_HEIGHT" background.corner_radius="$PILL_RADIUS" \
    click_script="$PLUGIN_DIR/aerospace.sh $sid click" \
    "${driver[@]}"
done
# "+N": the workspaces that did not fit beside the weather box (fit.sh); one at the end of each pill.
more_item() { # item name
  sketchybar --add item "$1" left \
    --set "$1" drawing=off icon.font="$FONT:Bold:$TEXT_SIZE" icon.color="$OVERLAY0" icon.padding_left=4 icon.padding_right=4 \
    label.drawing=off padding_left=1 padding_right=1
}
more_item space.more
sketchybar --add bracket spaces '/space\..*/'
pill spaces

# The workspaces of another monitor are a pill of their own, after the Mac's, marked with a monitor glyph: ext.N is
# Workspaces of the external monitor are named eN in AeroSpace and drawn as N.
# space.N for a workspace that lives on that monitor (aerospace.sh shows one or the other).
sketchybar --add item ext_gap left \
  --set ext_gap width="$PILL_GAP" padding_left=0 padding_right=0 icon.drawing=off label.drawing=off drawing=off \
  --add item ext.mark left \
  --set ext.mark drawing=off icon="$MONITOR" icon.font="$NERD_FONT:Regular:$ICON_SIZE" icon.color="$BLUE" icon.width=26 \
  icon.align=center icon.padding_left=0 icon.padding_right=0 label.drawing=off padding_left=1 padding_right=1
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item "ext.$sid" left \
    --subscribe "ext.$sid" mouse.entered mouse.exited \
    --set "ext.$sid" \
    icon="${sid#e}" icon.width=26 icon.align=center icon.padding_left=0 icon.padding_right=0 icon.font="$FONT:Bold:$TEXT_SIZE" \
    label.drawing=off drawing=off padding_left=1 padding_right=1 \
    background.drawing=on background.color="$TRANSPARENT" background.height="$PILL_HEIGHT" background.corner_radius="$PILL_RADIUS" \
    script="$PLUGIN_DIR/aerospace.sh $sid" click_script="$PLUGIN_DIR/aerospace.sh $sid click"
done
more_item ext.more
sketchybar --add bracket ext_spaces '/ext\..*/'
pill ext_spaces

# The pill that follows the pointer while a workspace is dragged (drag.sh); it is the last item on the left, so padding_left
# moves it freely over everything else.
sketchybar --add item drag_ghost left \
  --set drag_ghost drawing=off icon=0 icon.width=26 icon.align=center icon.padding_left=0 icon.padding_right=0 \
  icon.font="$FONT:Bold:$TEXT_SIZE" icon.color="$BASE" label.drawing=off padding_left=0 padding_right=0 \
  background.drawing=on background.color="$SPACE_BLOCK" background.height="$PILL_HEIGHT" background.corner_radius="$PILL_RADIUS"

# --- Left of the notch: the weather (the commune you are in and its temperature), then his moon phase box left of it
# (items left of the notch are laid out right to left) ---
sketchybar --add item weather q \
  --set weather icon="$WEATHER" icon.font="$NERD_FONT:Bold:$ICON_SIZE" icon.color="$PINK" \
  update_freq=1800 script="$PLUGIN_DIR/weather.sh" \
  --subscribe weather system_woke
pill weather
sketchybar --add item weather.moon q \
  --set weather.moon icon.font="$NERD_FONT:Bold:$MOON_SIZE" icon.color="$CRUST" \
  icon.padding_left=4 icon.padding_right=3 label.drawing=off update_freq=3600 script="$PLUGIN_DIR/moon.sh" \
  --subscribe weather.moon system_woke
pill weather.moon
sketchybar --set weather.moon background.color="$MOON_BLOCK"

# --- Right of the notch: his Spotify (the logo, green while playing, then "title  artist"), for whatever plays ---
# media.sh slides it open and closed (our animation); a click plays or pauses.
sketchybar --add event now_playing_change \
  --add item media_icon e \
  --set media_icon drawing=off icon="$SPOTIFY" icon.font="$NERD_FONT:Bold:$SPOTIFY_SIZE" icon.color="$GREEN" \
  icon.padding_left=6 icon.padding_right=4 label.drawing=off padding_left=0 padding_right=0 \
  click_script="$PLUGIN_DIR/close_popups.sh; media-control toggle-play-pause; $PLUGIN_DIR/media.sh" \
  --add item media e \
  --set media drawing=off icon.drawing=off label.font="$FONT:Bold:$TEXT_SIZE" label.padding_left=0 \
  label.padding_right=8 padding_left=0 update_freq=5 updates=on script="$PLUGIN_DIR/media.sh" \
  click_script="$PLUGIN_DIR/close_popups.sh; media-control toggle-play-pause; $PLUGIN_DIR/media.sh" \
  --subscribe media now_playing_change \
  --add bracket media_pill media_icon media
pill media_pill

# --- Right (added right to left, after Control Center above): the time (no click), the date (Calendar), the battery, Vorssaint ---
# Each label keeps one width, so nothing right of Vorssaint ever moves.
sketchybar --add item clock right \
  --set clock icon="$TIME" icon.font="$NERD_FONT:Regular:$ICON_SIZE" icon.color="$YELLOW" \
  label.font="$FONT:Bold:$TEXT_SIZE" label.width="$TIME_LABEL_WIDTH" label.align=center update_freq=10 \
  script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock system_woke \
  --add item date right \
  --set date icon="$CALENDAR" icon.font="$NERD_FONT:Regular:$ICON_SIZE" icon.color="$RED" \
  label.width="$DATE_LABEL_WIDTH" label.align=center update_freq=60 \
  script="$PLUGIN_DIR/clock.sh" click_script="$PLUGIN_DIR/close_popups.sh; open -a Calendar" \
  --subscribe date mouse.entered mouse.exited system_woke \
  --add item battery right \
  --set battery icon.font="$NERD_FONT:Medium:$ICON_SIZE" \
  label.width="$BATTERY_LABEL_WIDTH" label.align=center update_freq=20 script="$PLUGIN_DIR/battery.sh" \
  click_script="open x-apple.systempreferences:com.apple.Battery-Settings.extension" \
  --subscribe battery system_woke power_source_change mouse.entered mouse.exited \
  --add item vorssaint right \
  --set vorssaint icon="$VORSSAINT" icon.font="$NERD_FONT:Regular:$ICON_SIZE" icon.color="$MAUVE" icon.width=28 icon.align=center \
  icon.padding_left=0 icon.padding_right=0 label.drawing=off \
  script="$PLUGIN_DIR/hover.sh $BAR_HOVER $BAR_COLOR" click_script="$PLUGIN_DIR/vorssaint.sh" \
  --subscribe vorssaint mouse.entered mouse.exited

for name in clock date battery vorssaint; do pill "$name"; done

sketchybar --hotload on
sketchybar --update
"$PLUGIN_DIR/vorssaint.sh" align &
# Fits the boxes against each other and the camera housing once everything is up (fit.sh; the plugins redo it as content changes).
"$PLUGIN_DIR/fit.sh" &

# Follows the pointer to drag workspaces (one watcher at a time: a reload replaces the old one).
pkill -f '^bash .*/plugins/drag\.sh$' 2>/dev/null
pkill -f '^[^ ]*/ctlcenter watch ' 2>/dev/null
rm -f "$HOME/.cache/sketchybar/dragging"
nohup "$PLUGIN_DIR/drag.sh" >/dev/null 2>&1 &

# Keeps the focus on a workspace whose last window closed (one watcher at a time, with its subscription).
pkill -f '^bash .*/plugins/stay\.sh$' 2>/dev/null
pkill -f '^aerospace subscribe --no-send-initial binding-triggered ' 2>/dev/null
nohup "$PLUGIN_DIR/stay.sh" >/dev/null 2>&1 &
# ...and keeps AeroSpace from going elsewhere at all when the app in front quits there (stay.sh is then left nothing to undo).
pkill -f '^[^ ]*/ctlcenter stay$' 2>/dev/null
nohup "$HOME/.local/bin/ctlcenter" stay >/dev/null 2>&1 &

# Tells the now playing pill the moment the player changes (one watcher at a time, with its stream).
pkill -f '^bash .*/plugins/media_watch\.sh$' 2>/dev/null
pkill -f 'media-control/mediaremote-adapter\.pl .* stream$' 2>/dev/null # media-control runs its stream in Perl
nohup "$PLUGIN_DIR/media_watch.sh" >/dev/null 2>&1 &

# Takes the picture the cover will show (in the background, the bar is already up).
"$PLUGIN_DIR/cover.sh" remember >/dev/null 2>&1 &
